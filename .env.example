# Copy to .env and adjust. .env is git-ignored; never commit real keys.
# Nothing here reaches the browser: the backend reads these, and the Vite config
# reads API_PORT at startup. Vite only exposes VITE_-prefixed variables to
# browser code, and none are used.

# development | production | test
NODE_ENV=development

# Backend HTTP port.
PORT=3001
HOST=127.0.0.1

# Port the Vite dev server proxies /api to. Keep equal to PORT above.
API_PORT=3001

# SQLite database: "file:<path>" or ":memory:". Required when NODE_ENV=production.
DATABASE_URL=file:./data/fitness-lab.db

# Optional. Enables AI-written experiment insights (Groq); the app works without it.
GROQ_API_KEY=
# Groq model for analysis text (optional; default llama-3.3-70b-versatile).
GROQ_MODEL= llama-3.3-70b-versatile
