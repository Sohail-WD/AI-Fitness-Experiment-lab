# Copy to .env and adjust. .env is git-ignored; never commit real keys.
# Nothing here reaches the browser: the backend reads these, and the Vite config
# reads API_PORT at startup. Vite only exposes VITE_-prefixed variables to
# browser code, and none are used.

# development | production | test
NODE_ENV=development

# Backend HTTP port.
PORT=3001
HOST=127.0.0.1

# Port the Vite dev server proxies /api to. Keep equal to PORT above.
API_PORT=3001

# SQLite database: "file:<path>" or ":memory:". Required when NODE_ENV=production.
DATABASE_URL=file:./data/fitness-lab.db

# Optional. Enables AI-written experiment insights (Groq); the app works without it.
GROQ_API_KEY=
# Groq model for analysis text (optional; default openai/gpt-oss-120b, verified live 2026-09-30).
GROQ_MODEL=openai/gpt-oss-120b

# --- Production ---
# With NODE_ENV=production the backend also serves the built frontend from ./dist
# (run `npm run build` first) unless SERVE_FRONTEND=false (API-only, e.g. frontend on Vercel).
# SERVE_FRONTEND=true does the same outside production; STATIC_DIR overrides the folder.
# In production DATABASE_URL must be an ABSOLUTE path (e.g. file:/var/data/fitness-lab.db).
# SERVE_FRONTEND=false
# STATIC_DIR=
# Only needed if the frontend is hosted on a different origin, e.g. https://lab.example.com
# (bare origin, no path). Leave unset when the backend serves the frontend itself.
# CORS_ORIGIN=
# Max AI analysis requests per client IP per minute (1-1000).
AI_RATE_LIMIT_PER_MINUTE=10

# --- Public demo: anonymous visitors and abuse limits ---
# Which X-Forwarded-For entries to trust: "none", a hop count (1-5), or proxy IPs/CIDRs.
# Required in production. "true" is refused (clients could choose their own IP).
# TRUST_PROXY=none
# Temporarily "true" after deploying to log the forwarded-IP chain on /api/health requests.
# DEBUG_PROXY_HEADERS=false
# Inactive visitors are deleted with all their data after this many days (1-365).
VISITOR_RETENTION_DAYS=30
# AI analyses per visitor per UTC day, and for all visitors together.
AI_DAILY_LIMIT_PER_VISITOR=20
AI_DAILY_LIMIT_TOTAL=500
# New demo sessions (first profile save) per client IP per hour, and overall per hour.
NEW_VISITORS_PER_IP_PER_HOUR=10
NEW_VISITORS_PER_HOUR=200
# State-changing API requests per client IP per minute for visitors with a session
# ("Delete my data" is always allowed).
WRITE_RATE_LIMIT_PER_MINUTE=120
